{
  "name": "nodejs-auth-api",
  "version": "1.0.0",
  "description": "RESTful authentication API built with Node.js, Express, MongoDB, and JWT.",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "start": "node index.js",
    "dev": "nodemon index.js"
  },
  "jest": {
    "projects": [
      {
        "displayName": "integration",
        "testMatch": [
          "<rootDir>/tests/**/*.test.js"
        ],
        "testPathIgnorePatterns": [
          "<rootDir>/tests/unit/"
        ],
        "globalSetup": "<rootDir>/tests/setup/globalSetup.js",
        "globalTeardown": "<rootDir>/tests/setup/globalTeardown.js",
        "setupFilesAfterEnv": [
          "<rootDir>/tests/setup/mongodb.js"
        ]
      },
      {
        "displayName": "unit",
        "testMatch": [
          "<rootDir>/tests/unit/**/*.test.js"
        ]
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chandru-svs/nodejs-auth-api.git"
  },
  "author": "chandru",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Chandru-svs/nodejs-auth-api/issues"
  },
  "homepage": "https://github.com/Chandru-svs/nodejs-auth-api#readme",
  "dependencies": {
    "axios": "^1.14.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "moment": "^2.30.1",
    "mongoose": "^9.3.0",
    "morgan": "^1.12.0",
    "redis": "^5.11.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  }
}
